# =============================================================================
# Memory Benchmarks — Environment Configuration
# =============================================================================
# Copy to .env and fill in your values:  cp .env.example .env

# ---------------------------------------------------------------------------
# Required: LLM Provider (for answer generation, judging, AND Mem0 extraction)
# ---------------------------------------------------------------------------
OPENAI_API_KEY=your_openai_api_key

# Used by the local Mem0 server for embeddings. If omitted, the server falls
# back to OPENAI_API_KEY, which may itself be an OpenRouter key.
OPENROUTER_API_KEY=your_openrouter_api_key
OPENROUTER_EMBEDDING_URL=https://openrouter.ai/api/v1/embeddings

# Optional: Other LLM providers (for answer/judge models)
# ANTHROPIC_API_KEY=your_anthropic_api_key
# AZURE_OPENAI_API_KEY=your_azure_key
# AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com

# ---------------------------------------------------------------------------
# Mem0 Backend — OSS Server (default)
# ---------------------------------------------------------------------------
# Start with: docker compose up -d
# The server runs at http://localhost:8888 by default.
MEM0_HOST=http://localhost:8888
MEM0_BACKEND=oss

# Server model config (override in docker-compose or here)
# LLM_MODEL=gpt-4o-mini
# EMBEDDER_PROVIDER=openrouter
# EMBEDDER_MODEL=openai/text-embedding-3-small
# EMBEDDING_DIMS=1536

# Memory-write gate. Both hosted APIs and local vLLM are supported through an
# OpenAI-compatible chat/completions endpoint.
MEMORY_GATE_ENABLED=true
MEMORY_GATE_FAIL_OPEN=true
MEMORY_GATE_MODEL=deepseek-chat
MEMORY_GATE_PROMPT_FORMAT=json
# MEMORY_GATE_BASE_URL=https://api.deepseek.com
# MEMORY_GATE_API_KEY=your_gate_api_key
# Local vLLM example:
# MEMORY_GATE_MODEL=your-local-model
# MEMORY_GATE_BASE_URL=http://host.docker.internal:8000/v1
# MEMORY_GATE_API_KEY=local-vllm
# MEMORY_GATE_PROMPT_FORMAT=alpaca_boolean

# ---------------------------------------------------------------------------
# Mem0 Backend — Cloud (alternative)
# ---------------------------------------------------------------------------
# To use Mem0 cloud instead of self-hosted:
# MEM0_BACKEND=cloud
# MEM0_HOST=https://api.mem0.ai
# MEM0_API_KEY=your_mem0_api_key
# MEM0_ORGANIZATION_ID=your_org_id
# MEM0_PROJECT_ID=your_project_id
